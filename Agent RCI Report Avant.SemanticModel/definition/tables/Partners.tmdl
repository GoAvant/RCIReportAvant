table Partners
	lineageTag: 6b949a12-1c3c-494e-87ba-5d4efcd56904

	measure _Selected_Seller =
			
			VAR Seller =
			    IF (
			        DISTINCTCOUNT ( Partners[Partner] ) == 1,
			        FIRSTNONBLANK ( Partners[Partner], Partners[Partner] ),
			        "More than one"
			    )
			RETURN
			    ( Seller )
		lineageTag: 3a71a21d-5f42-42f3-a72f-0fe271310e17

	measure _LinkToPublicDeck =
			
			VAR EmbedURL = "https://app.powerbi.com/links/Xf58BpOUVb?ctid=81a0173f-15cd-454e-bbf8-7a6606b7349a&pbi_source=linkShare"
			VAR FinalURL =
			    IF (
			        HASONEVALUE ( Partners[Partner] ),
			        CONCATENATE (
			            EmbedURL,
			            CONCATENATE (
			                "&filter=Partners/Partner eq ",
			                "'" & FIRSTNONBLANK ( Partners[Partner], Partners[Partner] ) & "'"
			            )
			        ),
			        EmbedURL
			    )
			RETURN
			    FinalURL
		lineageTag: f3c4ab1a-99ea-4729-8989-ba5eb3fb95d3
		dataCategory: WebUrl

