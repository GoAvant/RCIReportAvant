	column CompGroup =
			
			SWITCH(
			    TRUE(),
			    'Partners'[Standard Comp Percent] < 70, "≤ 70%",
			    'Partners'[Standard Comp Percent] >= 70 && 'Partners'[Standard Comp Percent] < 75, "70% - 75%",
			    'Partners'[Standard Comp Percent] >= 75 && 'Partners'[Standard Comp Percent] < 80, "75% - 80%",
			    'Partners'[Standard Comp Percent] >= 80 && 'Partners'[Standard Comp Percent] < 85, "80% - 85%",
			    'Partners'[Standard Comp Percent] >= 85 && 'Partners'[Standard Comp Percent] < 90, "85% - 90%",
			    'Partners'[Standard Comp Percent] >= 90 && 'Partners'[Standard Comp Percent] < 95, "90% - 95%",
			    ">= 95%"
			)
		lineageTag: 191f5831-03de-4408-b127-5d1584e107ee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Partners = m
		mode: import
		queryGroup: 'Import Tables'
		source =
				let
				    Source = Sql.Database("db-server-prod-eastus-dw-01.database.windows.net", "AvantDW"),
				    pbi_Partners = Source{[Schema="pbi",Item="Partners"]}[Data],
				    #"Replaced Value" = Table.ReplaceValue(pbi_Partners,null,1,Replacer.ReplaceValue,{"Standard Comp Percent"})
				in
