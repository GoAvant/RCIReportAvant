	measure '_Expected Margin Comp Converted Closed CYTD' =
			
			CALCULATE (
			    [_Expected Margin Comp Converted Closed],
			    FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurYearOffset] == 0 )
			)
		formatString: \$#,0;(\$#,0);\$#,0
