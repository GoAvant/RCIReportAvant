	measure Selected_Priority =
			
			IF (
			    DISTINCTCOUNT ( Partners[Seller (Combined)] ) == 1,
			    MAX ( Partners[Seller Priority] ),
			    "N/A"
			)
		lineageTag: af05b40a-d67e-4e22-a4af-faf9d0fa142d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total MRC L12M by Bucket (Partners)' = ```
			
			VAR hasOneBucket = HASONEVALUE ( 'MRC Bins'[BucketLabel] )
			
			VAR binMinBound =
			    IF (
			        hasOneBucket,
			        MIN ( 'MRC Bins'[Min] ),
			        -- Open-ended lower bound for totals (treat as -infinity)
			        -1.0e308
			    )
			
			VAR binMaxBound =
			    IF (
			        hasOneBucket,
			        MIN ( 'MRC Bins'[Max] ),
			        -- Open-ended upper bound for totals (treat as +infinity)
			        1.0e308
			    )
			
			VAR perPartnerWithL12M =
			    ADDCOLUMNS (
			        VALUES ( Partners[Seller Id] ),
			        "v", CALCULATE ( [_MRC L12M (from Today)] )
			        -- If you want blanks to count as zero so they fall in "<25k", use:
			        -- "v", COALESCE ( CALCULATE ( [_MRC L12M (from Today)] ), 0 )
			    )
			RETURN
			SUMX (
			    FILTER ( perPartnerWithL12M, [v] >= binMinBound && [v] < binMaxBound ),
			    [v]
			)
			
			```
		lineageTag: 3b359a2e-0fb2-405a-b5b9-308695e65582

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _TACost_12 =
			
			
			CALCULATE (
			    [_TotalAvantCost],
			    'Calendar'[CurMonthOffset] <= -1
			        && 'Calendar'[CurMonthOffset] >= -12
			)
		lineageTag: e8962c82-6c6d-46c0-ad0c-2e318c2cb090

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _TAEM(TCV_12) =
			
			
			VAR oppterm = SUMX(Opportunities,[Expected Margin] * Opportunities[Opportunity Term])
			
			RETURN
			CALCULATE (
			    oppterm ,
			    'Calendar'[CurMonthOffset] <= -1
			        && 'Calendar'[CurMonthOffset] >= -12
			)
		lineageTag: 06d68323-55a1-4b1d-94f2-343f67f45e70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _TAProfitability =
			
			
			VAR oppterm = SUMX(Opportunities,[Expected Margin] * Opportunities[Opportunity Term])
			
			RETURN
			CALCULATE (
			    oppterm - [_TotalAvantCost],
			    'Calendar'[CurMonthOffset] <= -1
			        && 'Calendar'[CurMonthOffset] >= -12
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b1231e6b-8b04-48a5-a3fb-9eecc9929298

	measure '_Avg MRC L12M per Seller by Bucket (Partners)' =
			
			VAR hasOneBucket = HASONEVALUE ( 'MRC Bins'[BucketLabel] )
			VAR binMinBound = IF ( hasOneBucket, MIN('MRC Bins'[Min]), -1.0e308 )
			VAR binMaxBound = IF ( hasOneBucket, MIN('MRC Bins'[Max]),  1.0e308 )
			
			VAR perPartnerWithL12M =
			    ADDCOLUMNS (
			        VALUES ( Partners[Seller Id] ),
			        "v", CALCULATE ( [_MRC L12M (from Today)] )
			        -- Or: "v", COALESCE ( CALCULATE ( [_MRC L12M (from Today)] ), 0 )
			    )
			
			VAR filteredSellersInBucket =
			    FILTER ( perPartnerWithL12M, [v] >= binMinBound && [v] < binMaxBound )
			
			VAR numerator   = SUMX ( filteredSellersInBucket, [v] )
			VAR denominator = COUNTROWS ( filteredSellersInBucket )
			RETURN
			    DIVIDE ( numerator, denominator )   -- safe divide; returns BLANK if denom=0
		lineageTag: 728f3036-3f99-4183-8c81-5d82e9950b7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

