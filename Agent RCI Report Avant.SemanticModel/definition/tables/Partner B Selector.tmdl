table 'Partner B Selector'
	lineageTag: 3e5cc74b-f558-483a-ae3d-fb522b116740

	measure '_Selected Partner B' = ```
			
			VAR Seller =
			    IF (
			        DISTINCTCOUNT ( 'Partner B Selector'[Seller (Combined)]  ) == 1,
			        FIRSTNONBLANK ( 'Partner B Selector'[Seller (Combined)] , 'Partner B Selector'[Seller (Combined)] ),
			        "More than one"
			    )
			RETURN
			    ( Seller )
			
			```
		lineageTag: b4373273-b71f-4586-935c-8bf6350893d4

	measure '_Selected Partner B (Label)' = ```
			
			SELECTEDVALUE ( 'Partner B Selector'[Seller (Combined)], "Select Partner B" )
			
			```
		lineageTag: 2c11bea0-2060-449d-9ae6-63bfdac5daec

	measure '_Average Enhanced Sale B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        [_Average Enhanced Sale],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Seller (Combined)] )
			    )
			)
		lineageTag: c1b4a858-8c32-42fa-8f5b-49b05bca6cb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

