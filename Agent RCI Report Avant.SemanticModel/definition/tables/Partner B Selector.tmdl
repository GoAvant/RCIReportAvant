	measure '_TACost_12 B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        [_TotalAvantCost],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Partner] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
		lineageTag: fee7ee42-9ada-480a-b953-acbcfb50334a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_TAEM(TCV_12) B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        -- OppTerm within the injected Partner A + last 12 completed months
			        SUMX ( Opportunities, [Expected Margin] * Opportunities[Opportunity Term] ),
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Partner] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
		lineageTag: 2966a02a-ed3c-4df6-bd34-e1441e452dd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_TAProfitability B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			VAR OppTermB12 =
			    CALCULATE (
			        SUMX ( Opportunities, [Expected Margin] * Opportunities[Opportunity Term] ),
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Partner] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			VAR TotalCostB12 =
			    CALCULATE (
			        [_TotalAvantCost],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Partner] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    OppTermB12 - TotalCostB12
			)
		lineageTag: 4bd87511-94dd-4d87-abd9-7d09854ee374

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected_Priority B' = ```
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        SELECTEDVALUE ( Partners[Seller Priority] ),
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Seller (Combined)] )
			    )
			)
			
			```
		lineageTag: 90b9f73a-c709-43dc-a210-7a6957882845

	measure '_TAMMRC_12 B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        SUM ( Opportunities[Amount(Converted)] ),
			        // Ensure we only consider Closed Won Approved
			        KEEPFILTERS ( Opportunities[Stage] = "Closed Won Approved" ),
			
			        // Normalize partner context and inject the selected partner
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Partner] ),
			
			        // Rolling window: from -12 to -1 inclusive
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
		lineageTag: 2fe3c84f-3aa1-4982-bef9-bf6e916d8d07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

