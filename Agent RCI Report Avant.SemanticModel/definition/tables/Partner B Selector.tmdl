	measure '_Expected Margin Closed Last 12 months B' =
			
			VAR PartnerBKey = [_Selected Partner B]
			RETURN
			IF (
			    ISBLANK ( PartnerBKey ),
			    BLANK (),
			    CALCULATE (
			        [_Expected Margin Comp Converted Closed],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerBKey }, Partners[Seller (Combined)] ),
			        FILTER ( ALL ( 'Calendar'[CurMonthOffset] ), 'Calendar'[CurMonthOffset] >= -11 && 'Calendar'[CurMonthOffset] <= 0 )
			    )
