	measure _LEADBillableHours =
			
			VAR leadnames =
			    VALUES ( _LEAD[LEAD Name] )
			RETURN
			    CALCULATE (
			        SUM ( 'Maintenance Time'[Duration__c] ) / 60,
			        'Cases'[Record_Type_Name__c] = "Sales Engineering",
			        USERELATIONSHIP ( 'Calendar'[Date], 'Maintenance Time'[CreatedDate] ),
			        'Cases'[RO_Case_Owner__c] IN leadnames
			    )
		displayFolder: SE
		lineageTag: a9ce1875-fab6-4619-9540-393eee4ecd93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _AllLEADBillableHours =
			
			CALCULATE ( [_LEADBillableHours], ALL ( 'Maintenance Time' ) )
		displayFolder: SE
		lineageTag: e01e5461-b607-43a7-b44d-384cce479db8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_LEADSal Orig' = ```
			
			 343083 * [_CountLEADs]
			```
		formatString: 0
		displayFolder: SE
