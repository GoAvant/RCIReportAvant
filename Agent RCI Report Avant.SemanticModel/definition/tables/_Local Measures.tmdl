			VAR SPARank =
			    RANKX ( FilteredPartners, [_OrderMgmtUsage],, ASC, DENSE )
			RETURN
			    IF (
			        [_Date range] = 0
			            || [_TotalAvantCost] < 500
			            || [_12MOrderMgmtBillableHours] = BLANK (),
