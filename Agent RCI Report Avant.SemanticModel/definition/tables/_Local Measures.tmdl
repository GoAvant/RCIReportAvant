			VAR LEAD1 =
			    DIVIDE ( [_LEADBillableHours], [_AllLEADBillableHours], 0 ) * [_LEADSal]
			VAR SE = FSE + ISE + LEAD1
			VAR Comm =
			    DIVIDE ( [_CommissionsCases], [_AllCommCases], 0 ) * [_CommSal]
			VAR PA =
			    DIVIDE ( [_PABillableHours], [_AllPABillableHours], 0 ) * [_PricingSal]
			VAR OrderMgmt =
			    DIVIDE ( [_OrderMgmtBillableHours], [_AllOrderMgmtBillableHours], 0 ) * [_OrderMgmtSal]
			VAR PF =
			    DIVIDE ( [_ActiveUserPeriod], [_AllPFLogin], 0 ) * 1800000
			VAR PC =
			    DIVIDE ( [_ProjectCordNetTotals], [_AllProjectCord], 0 ) * [_PCSal]
			// VAR PSM =
			//     DIVIDE ( [_PSMTotalHours], [_AllPSMHours], 0 ) * [_PSMSAl]
			RETURN
			    IF ( [_Date range] = 1, ( SE + Comm + PC + PA + OrderMgmt + PF) )
