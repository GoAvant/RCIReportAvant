	measure _12MTotalAvantCost =
			
			VAR FSE = ( [_FSEBillableHours] / [_AllFSEBillableHours] ) * [_FSESal]
			VAR ISE = ( [_ISEBillableHours] / [_AllISEBillableHours] ) * [_ISESal]
			VAR LEAD1 =
			    DIVIDE ( [_LEADBillableHours], [_AllLEADBillableHours], 0 ) * [_LEADSal]
			VAR SE = FSE + ISE + LEAD1
			VAR Comm = ( [_CommissionsCases] / [_AllCommCases] ) * [_CommSal]
			VAR PA = ( [_PABillableHours] / [_AllPABillableHours] ) * [_PricingSal]
			VAR OrderMgmt = ( [_OrderMgmtBillableHours] / [_AllOrderMgmtBillableHours] ) * [_OrderMgmtSal]
			VAR PF = ( [_ActiveUserPeriod] / [_AllPFLogin] ) * 1800000
			VAR PC = ( [_ProjectCordNetTotals] / [_AllProjectCord] ) * [_PCSal]
			// VAR PSM = ( [_PSMTotalHours] / [_AllPSMHours] ) * [_PSMSAl]
			RETURN
			    CALCULATE (
			        IF ( [_Date range] = 1, ( PA + Comm + SE + OrderMgmt + PF + PC) ),
			        FILTER (
			            'Calendar',
			            'Calendar'[CurMonthOffset] <= -1
			                && 'Calendar'[CurMonthOffset] >= -12
			        )
			    )
		lineageTag: 697a4008-7381-4026-bb2b-b32cf9a734be

