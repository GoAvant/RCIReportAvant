		lineageTag: 3e535284-f446-4960-827c-c76a4ba1f491

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _CountLEADs =
			
			DISTINCTCOUNTNOBLANK ( _LEAD[LEAD Name])
		formatString: 0
		displayFolder: SE
