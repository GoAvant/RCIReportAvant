	measure _12MSETotalAvantCost =
			
			CALCULATE (
			    [_TotalAvantCostSE],
			    ( 'Calendar'[CurMonthOffset] <= -1 )
			        && ( 'Calendar'[CurMonthOffset] >= -12 )
			)
		displayFolder: SE
