	measure _TotalAvantCostSE =
			
			VAR FSE = DIVIDE( [_FSEBillableHours], [_AllFSEBillableHours],0 ) * [_FSESal]
			VAR ISE = DIVIDE( [_ISEBillableHours], [_AllISEBillableHours],0 ) * [_ISESal]
			VAR LEAD1 = DIVIDE( [_LEADBillableHours], [_AllLEADBillableHours],0 ) * [_LEADSal]
			VAR SE = FSE + ISE + LEAD1
			RETURN
			    IF ( [_Date range] = 1, SE )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: SE
		lineageTag: 59bd2554-fb0a-4105-9b93-47786e520daa

		changedProperty = Name

		changedProperty = DisplayFolder

	measure _SEUsageTable =
			
