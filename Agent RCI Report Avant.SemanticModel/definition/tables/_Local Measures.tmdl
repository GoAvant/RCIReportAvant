	measure '_Selected Partners' =
			
			VAR SelectedPartners =
			    CALCULATETABLE (
			        VALUES ( Partners[Partner] ),
			        FILTER (
			            Partners,
			            Partners[Status] = "Contract Signed"
			                && Partners[Seller Priority] <> "Inactive"
			        )
			    )
			VAR CountOfPartners =
			    COUNTROWS ( SelectedPartners )
			VAR SelectedPartnersString =
			    IF (
			        CountOfPartners <= 10,
			        CONCATENATEX (
			            SelectedPartners,
			            Partners[Partner],
			            ", ",
			            Partners[Partner], ASC
			        ),
			        "More than 10 Partners Selected"
			    )
			RETURN
			    SelectedPartnersString
		lineageTag: 1c0b4064-b42a-4d4e-9565-212cf5c94004

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Selected CM' =
			
			VAR SelectedCMs =
			    FILTERS ( 'Channel Managers'[Channel Manager] )
			VAR CountOfCMs =
			    COUNTROWS ( SelectedCMs )
			VAR NumOfAllCMs =
			    COUNTROWS ( ALL ( 'Channel Managers' ) )
			VAR AllCMsSelected = CountOfCMs = NumOfAllCMs
			VAR SelectedCMsString =
			    IF (
			        CountOfCMs <= 10,
			        CONCATENATEX (
			            SelectedCMS,
			            'Channel Managers'[Channel Manager],
			            ", ",
			            'Channel Managers'[Channel Manager], ASC
			        ),
			        "More than 10 CMs Selected"
			    )
			RETURN
			    SelectedCMsString
		lineageTag: 9b3bae1b-6a99-4358-9182-4225ce27a553

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _MasterPER =
			
			VAR FSE =
			    DIVIDE ( [_FSEBillableHours], [_AllFSEBillableHours], 0 ) * [_FSESal]
			VAR ISE =
			    DIVIDE ( [_ISEBillableHours], [_AllISEBillableHours], 0 ) * [_ISESal]
			VAR SE = FSE + ISE
			VAR Comm =
			    DIVIDE ( [_CommissionsCases], [_AllCommCases], 0 ) * [_CommSal]
			VAR PA =
			    DIVIDE ( [_PABillableHours], [_AllPABillableHours], 0 ) * [_PricingSal]
			VAR OrderMgmt =
			    DIVIDE ( [_OrderMgmtBillableHours], [_AllOrderMgmtBillableHours], 0 ) * [_OrderMgmtSal]
			VAR PF =
			    DIVIDE ( [_ActiveUserPeriod], [_AllPFLogin], 0 ) * 1800000
			VAR PC =
			    DIVIDE ( [_ProjectCordNetTotals], [_AllProjectCord], 0 ) * [_PCSal]
			// VAR PSM =
			    // DIVIDE ( [_PSMTotalHours], [_AllPSMHours], 0 ) * [_PSMSAl]
			RETURN
			    DIVIDE ( [Expected Margin], SE + Comm + PA + OrderMgmt + PF + PC, 0 )
		formatString: 0.0000
		lineageTag: ba7687aa-e1e1-4f1e-8a73-de9f0a4f8868

