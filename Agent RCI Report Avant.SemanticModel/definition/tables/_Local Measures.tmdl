table '_Local Measures'
	lineageTag: 2576d224-4b05-4ed5-bf9b-7ab014686158

	measure '_PA Abuser' =
			
			IF (
			    [_12MPABillableHours] >= 12
			        && [_EM by PA Cases] <= 4.5
			        && [_NewPartner12Month] = BLANK (),
			    1
			)
		displayFolder: PA
		lineageTag: 0f4a750e-d7ec-47fd-a3b3-1109f6a600d2

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _PABillableHours =
			
			VAR pricing =
			    CALCULATE (
			        SUM ( 'Cases'[_PricingComplexityTime] ) / 60,
			        'Cases'[Record_Type_Name__c] = "Pricing",
			        'Cases'[Reason] = "Needs Pricing Analyst",
			        USERELATIONSHIP ( 'Cases'[ClosedDate], 'Calendar'[Date] )
			    )
			VAR specializedpricing =
			    CALCULATE (
			        SUM ( 'Leading Providers'[_LPMinutes] ) / 60,
			        'Cases'[Record_Type_Name__c] = "Pricing",
			        'Cases'[Reason] = "Needs Specialized Pricing",
			        USERELATIONSHIP ( 'Cases'[Id], 'Leading Providers'[Case__c] ),
			        USERELATIONSHIP ( 'Cases'[ClosedDate], 'Calendar'[Date] )
			    )
			RETURN
			    IF (
			        ISBLANK ( pricing + specializedpricing ),
			        0,
			        ( pricing + specializedpricing )
			    )
		formatString: #,0
		displayFolder: PA
		lineageTag: ae790b77-0efe-47f6-b261-c5b1662aff20

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isDecimal":true}

	measure _PAUsage =
			
			DIVIDE ( [_12MExpected Margin], [_12MPABillableHours] )
		displayFolder: PA
		lineageTag: 61d8435e-f5e7-4f53-99b0-c025eacb88f6

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _PAPercentile =
			
			VAR FilteredPartners =
			    FILTER (
			        ALL ( Partners),
			        [_PAUsage] > 0
			            && [_Date range] = 1
			            && [_TotalAvantCost] >= 500
			            && NOT ( ISBLANK ( [_12MPABillableHours] ) )
			    )
			VAR PAUsage =
			    COUNTROWS ( FilteredPartners )
			VAR PARank =
			    RANKX ( FilteredPartners, [_PAUsage],, ASC, DENSE )
			RETURN
			    IF (
			        [_Date range] = 0
			            || [_TotalAvantCost] < 500,
			        BLANK (),
			        DIVIDE ( PARank, PAUsage )
			    )
		formatString: 0%;-0%;0%
		displayFolder: PA
		lineageTag: 99582e48-7a88-43c9-8773-885b50153405

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure _CountPACaseOwners =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Cases'[RO_Case_Owner__c] ),
			    'Cases'[RO_Case_Owner__c] <> "Virtual Pricing Analyst",
			    'Cases'[Reason] = "Needs Pricing Analyst"
			        || 'Cases'[Reason] = "Needs Specialized Pricing",
			    USERELATIONSHIP ( 'Cases'[ClosedDate], 'Calendar'[Date] )
			)
		displayFolder: PA
		lineageTag: 097868e7-0d40-469f-9f00-787f6e7c6720

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _AllPABillableHours =
			
			CALCULATE ( [_PABillableHours], ALL ( 'Maintenance Time' ) )
		formatString: 0
		displayFolder: PA
		lineageTag: c910a597-bf5f-401c-b167-55f7befce4cd

		changedProperty = FormatString

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isDecimal":true}

	measure _12MPABillableHours =
			
			CALCULATE (
			    [_PABillableHours],
			    ( 'Calendar'[CurMonthOffset] <= -1 )
			        && ( 'Calendar'[CurMonthOffset] >= -12 )
			)
		formatString: 0
		displayFolder: PA
		lineageTag: 4768c5b6-745a-490a-ac59-16b3676d0414

		changedProperty = FormatString

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isDecimal":true}

	measure _PricingSal =
			
			39750 * [_CountPACaseOwners]
		displayFolder: PA
		lineageTag: 41bcbc6e-96ba-4a1b-ae2c-197dc922b0c3

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _TotalAvantCostPA =
			
			VAR PA = DIVIDE([_PABillableHours], [_AllPABillableHours],0 ) * [_PricingSal]
			RETURN
			    IF ( [_Date range] = 1, PA )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: PA
		lineageTag: 9e320c23-492b-4d78-9544-b3031d6fe538

		changedProperty = Name

		changedProperty = DisplayFolder

	measure _12MPATotalAvantCost =
			
