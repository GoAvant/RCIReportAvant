	column 'MRC L12M Bucket' = ```
			
			VAR v = [_MRC L12M (from Today)]
			RETURN
			SWITCH (
			    TRUE(),
			    v < 25000,                   "< 25k",
			    v < 50000,                   "25–50k",
			    v < 125000,                  "50–125k",
			    v < 300000,                  "125–300k",
			                                 "≥ 300k"
			)
			
			```
		lineageTag: 513b8266-4906-4e00-a51a-54bbf63b1652
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

