table Opportunities
	lineageTag: cc10f156-2b0a-4456-883b-299e5db8baac

	measure MRC =
			
			CALCULATE (
			    SUM ( Opportunities[Amount(Converted)] ),
			    Opportunities[Stage] == "Closed Won Approved",
			    Opportunities[Sales Model] <> "Wholesale"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c6271bb2-3b83-4500-b9dc-17059727ec88

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expected Margin' =
			
			CALCULATE (
			    SUM ( Opportunities[Expected Margin Comp (Converted)] ),
			    Opportunities[Stage] == "Closed Won Approved",
			    Opportunities[Sales Model] <> "Wholesale"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9580971c-bb81-4337-b36c-c3e4a0def107

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":""}

	measure '_Expected Margin Comp Converted Closed' =
			
			VAR LastMonthMRC =
			    CALCULATE (
			        SUM ( Opportunities[Expected Margin Comp (Converted)] ),
			        ( Opportunities[Stage] == "Closed Won Approved" )
			            || ( Opportunities[Stage] == "Closed Won" ),
			        FILTER ( 'Calendar', 'Calendar'[CurMonthOffset] = -1 )
			    )
			VAR PriorMonthsMRC =
			    CALCULATE (
			        SUM ( Opportunities[Expected Margin Comp (Converted)] ),
			        ( Opportunities[Stage] == "Closed Won Approved" ),
			        FILTER ( 'Calendar', 'Calendar'[CurMonthOffset] <= -1 )
			    )
			RETURN
			    ( LastMonthMRC + PriorMonthsMRC )
		lineageTag: 30f85a75-9f53-440e-9ab7-f2f1f007ef73

		annotation PBI_FormatHint = {"isGeneralNumber":true}

