	measure '_TAMMRC_12 A' =
			
			VAR PartnerAKey = [_Selected Partner A]
			RETURN
			IF (
			    ISBLANK ( PartnerAKey ),
			    BLANK (),
			    CALCULATE (
			        SUM ( Opportunities[Amount(Converted)] ),
			        // Ensure we only consider Closed Won Approved
			        KEEPFILTERS ( Opportunities[Stage] = "Closed Won Approved" ),
			
			        // Normalize partner context and inject the selected partner
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerAKey }, Partners[Seller (Combined)] ),
			
			        // Rolling window: from -12 to -1 inclusive
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
		lineageTag: e65dda7a-5a25-4645-bebf-e3b195d6b85f

