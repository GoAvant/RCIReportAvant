			```
		lineageTag: 280b7409-a8e0-4820-8379-ced76a4da79e

	measure '_TACost_12 A' = ```
			
			VAR PartnerAKey = [_Selected Partner A]
			RETURN
			IF (
			    ISBLANK ( PartnerAKey ),
			    BLANK (),
			    CALCULATE (
			        [_TotalAvantCost],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerAKey }, Partners[Seller (Combined)] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
			
			```
		lineageTag: 22274175-9b77-4be6-a9c3-635777a28385

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_TAEM(TCV_12) A' = ```
			
			VAR PartnerAKey = [_Selected Partner A]
			RETURN
			IF (
			    ISBLANK ( PartnerAKey ),
			    BLANK (),
			    CALCULATE (
			        -- OppTerm within the injected Partner A + last 12 completed months
			        SUMX ( Opportunities, [Expected Margin] * Opportunities[Opportunity Term] ),
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerAKey }, Partners[Seller (Combined)] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			)
			
			```
		lineageTag: 92bc91f3-1021-4dd0-b595-9eea740c7e22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_TAProfitability A' = ```
			
			VAR PartnerAKey = [_Selected Partner A]
			VAR OppTermA12 =
			    CALCULATE (
			        SUMX ( Opportunities, [Expected Margin] * Opportunities[Opportunity Term] ),
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerAKey }, Partners[Seller (Combined)] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			VAR TotalCostA12 =
			    CALCULATE (
			        [_TotalAvantCost],
			        REMOVEFILTERS ( Partners ),
			        TREATAS ( { PartnerAKey }, Partners[Seller (Combined)] ),
			        FILTER (
			            ALL ( 'Calendar'[CurMonthOffset] ),
			            'Calendar'[CurMonthOffset] >= -12
			                && 'Calendar'[CurMonthOffset] <= -1
			        )
			    )
			RETURN
			IF (
			    ISBLANK ( PartnerAKey ),
			    BLANK (),
			    OppTermA12 - TotalCostA12
			)
			
			```
		lineageTag: 9ea50a66-1ed9-4406-95e4-58ebc13c2b43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

