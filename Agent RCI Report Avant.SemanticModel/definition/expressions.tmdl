expression 'Pendo DAU' =
		let
		    Source = Sql.Database("synapse-workspace-prod-av-ondemand.sql.azuresynapse.net", "PathfinderAnalyticsLakeDB", [Query="SELECT#(lf)    periodId,#(lf)    [server],#(lf)    accountId AS 'Account Name',#(lf)    SalesforceAccountID,#(lf)    salesforceuseridentifier,#(lf)    COUNT(DISTINCT SalesforceUserIdentifier) AS DailyActiveUser,#(lf)tenantdomain#(lf)FROM #(lf)    dbo.allevents#(lf)WHERE#(lf)     accountId NOT IN (#(lf)     'Dev Tenant', #(lf)     'Local Dev Tenant', #(lf)     'Test Tenant',#(lf)     'Default-Account', #(lf)     'AVANT Pathfinder Demo', #(lf)     'AVANT EMEA Pathfinder Demo', #(lf)     'Product Tenant',#(lf)     'Cassidy Test Seller Account',#(lf)     'Local Tenant'#(lf) )#(lf)GROUP BY#(lf)    periodId,#(lf)    accountId,#(lf)    SalesforceAccountID,#(lf)    salesforceuseridentifier#(lf)    ,[server]#(lf),tenantdomain#(lf)"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"periodId", type date}}),
		    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([salesforceuseridentifier] <> null) ),
		    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "PeriodUserKey", each Date.ToText([periodId],"yyyy-MM-dd") & "|" &[salesforceuseridentifier]),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"DailyActiveUser", Int64.Type}}),
		    #"Merged Queries" = Table.NestedJoin(#"Changed Type1", {"server"}, TenantMaster, {"server"}, "TenantMaster", JoinKind.LeftOuter),
		    #"Sorted Rows" = Table.Sort(#"Merged Queries",{{"Account Name", Order.Ascending}}),
		    #"Expanded TenantMaster" = Table.ExpandTableColumn(#"Sorted Rows", "TenantMaster", {"TenantID", "TenantName", "server", "SalesforceAccountID"}, {"TenantMaster.TenantID", "TenantMaster.TenantName", "TenantMaster.server", "TenantMaster.SalesforceAccountID"}),
		    #"Added Custom1" = Table.AddColumn(#"Expanded TenantMaster", "SalesforceAccountIDwDomain", each if [SalesforceAccountID] = null or Text.Trim([SalesforceAccountID]) = "" then [TenantMaster.SalesforceAccountID] else [SalesforceAccountID])
		in
		    #"Added Custom1"
	lineageTag: 15a96a78-c73a-4ae8-8d77-13862516cba3

