expression TenantMaster =
		let
		    Source = Sql.Database("db-server-prod-eastus-dw-01.database.windows.net", "AvantDW", [Query="SELECT #(lf)    tm.TenantID,#(lf)    tm.TenantName,#(lf)    tm.TenantDomain,#(lf)    tm.SalesforceAccountID,#(lf)    tm.SalesforceAccountType,#(lf)    tm.Status,#(lf)    tm.StyleTemplate,#(lf)    tm.LogoFileName,#(lf)    tm.IsTenantProvisioned,#(lf)    tm.IsUserMigrationRequired,#(lf)    tm.CreatedDate,#(lf)    tm.LastModifiedDate,#(lf)    tm.RegionID,#(lf)    tm.dwPipelineRunId,#(lf)    tm.dwCreatedDatetime#(lf)FROM #(lf)    land_core.TenantMaster tm#(lf)WHERE #(lf)    tm.dwCreatedDatetime = (#(lf)        SELECT #(lf)            MAX(sub.dwCreatedDatetime)#(lf)        FROM #(lf)            land_core.TenantMaster sub#(lf)        WHERE #(lf)            sub.TenantID = tm.TenantID#(lf)    );"]),
		    #"Removed Columns" = Table.RemoveColumns(Source,{"SalesforceAccountType", "Status", "StyleTemplate", "LogoFileName", "IsTenantProvisioned", "IsUserMigrationRequired", "CreatedDate", "LastModifiedDate", "RegionID", "dwPipelineRunId", "dwCreatedDatetime"}),
		    #"Trimmed Text" = Table.TransformColumns(#"Removed Columns",{{"TenantID", Text.Trim, type text}}),
		    #"Uppercased Text" = Table.TransformColumns(#"Trimmed Text",{{"TenantID", Text.Upper, type text}}),
		    #"Split Column by Delimiter" = Table.SplitColumn(#"Uppercased Text", "TenantDomain", Splitter.SplitTextByDelimiter("//", QuoteStyle.Csv), {"TenantDomain.1", "TenantDomain.2"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"TenantDomain.1", type text}, {"TenantDomain.2", type text}}),
		    #"Removed Columns1" = Table.RemoveColumns(#"Changed Type",{"TenantDomain.1"}),
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns1",{{"TenantDomain.2", "server"}}),
		    #"Lowercased Text" = Table.TransformColumns(#"Renamed Columns",{{"server", Text.Lower, type text}})
		in
		    #"Lowercased Text"
	lineageTag: aec0553f-c429-48a3-8f50-d2ade80b237f

